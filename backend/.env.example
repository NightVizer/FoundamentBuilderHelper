# Скопируйте в backend/.env и впишите ключ OpenRouter (https://openrouter.ai/settings/keys).
# Один ключ обслуживает и Jev, и LLM. Без ключа /recommend и /explain отвечают 502.
OPENROUTER_API_KEY=

# Проценты пригодности: jev (по ТЗ, по умолчанию) или rules (локальный rule engine, только для разработки).
SCORE_SOURCE=jev

# Jev (TypeSafe System One) через OpenRouter: один вызов = 4 вопроса Noul, noul x 100 = процент.
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SEC=20
# JEV_API_KEY=   (необязательно, по умолчанию OPENROUTER_API_KEY)

# LLM для текстов: DeepSeek V4 Flash через OpenRouter. Клиент сам добавит /v1/chat/completions к BASE_URL.
DEEPSEEK_BASE_URL=https://openrouter.ai/api
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_REASONING=off
DEEPSEEK_TIMEOUT_SEC=90
# DEEPSEEK_API_KEY=   (необязательно, по умолчанию OPENROUTER_API_KEY)
