# Скопируйте в backend/.env. Все переменные необязательны:
# без них score считает локальный rule engine, а текст ТЭО формируется шаблоном.

# LLM (DeepSeek) — текст обоснования для /report и плюсы/минусы для /analyze.
# LLM не выбирает фундамент и не меняет score, стоимость и трудозатраты.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=90

# Необязательная внешняя модель JEV: если задан URL, её оценки заменяют score rule engine.
# POST JSON с полями FoundationInput → ответ { "suitability": { "strip": 70, "slab": 65, "pile": 80, "column": 40 } }
JEV_API_URL=
JEV_API_KEY=
JEV_TIMEOUT_SEC=60
