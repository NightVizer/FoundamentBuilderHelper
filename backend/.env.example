# Шаг 1 — модель JEV (процент пригодности по типам фундамента)
# POST JSON с полями FoundationInput → ответ { "suitability": { "strip": 70, ... } }
JEV_API_URL=https://your-jev-service/analyze
JEV_API_KEY=
JEV_TIMEOUT_SEC=60

# Шаг 2 — DeepSeek (плюсы/минусы, без изменения процентов)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=90
